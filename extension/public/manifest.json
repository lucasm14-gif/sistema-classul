{
  "manifest_version": 3,
  "name": "Classul - Pedidos WhatsApp",
  "version": "2.15.1",
  "description": "Cria pedidos no sistema Classul direto do WhatsApp Web.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Classul",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "https://sistema-classul.vercel.app/*",
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "placa-homenagem.svg",
        "placa-homenagem-veludo-luxo.png",
        "bot-fotos/*",
        "inject.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}